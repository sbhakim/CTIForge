# LLM Provider API Keys (configure at least one)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Model selection
CTI_MODEL=gpt-4o
CTI_EMBEDDING_MODEL=text-embedding-3-small

# If you want local Hugging Face inference instead of APIs, switch the YAML
# config provider to one of:
#   local_qwen
#   local_mistral
#   local_llama
# and ensure the runtime has torch + transformers + accelerate installed.

# Similarity threshold for entity merging (0.0 to 1.0)
CTI_SIMILARITY_THRESHOLD=0.85

# Logging level
CTI_LOG_LEVEL=INFO
